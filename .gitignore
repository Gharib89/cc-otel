*.ignored

# Python
__pycache__/
*.pyc
.pytest_cache/

# Editor-local (per-machine git-lock mitigation, not shared config)
.vscode/

# ad-hoc analysis
.analysis/

# Power BI local validator cache + transient ajv install (.github/powerbi/validate.ps1)
.pbi-tools/
node_modules/
