{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.143.json",
  "name": "AIWorx.json",
  "dataColors": [
    "#3A44D4",
    "#0198CB",
    "#6E9A21",
    "#792A8E",
    "#A17E00",
    "#B61E24"
  ],
  "foreground": "#0E2841",
  "foregroundNeutralSecondary": "#5A6473",
  "foregroundNeutralTertiary": "#9AA0AA",
  "background": "#FFFFFF",
  "backgroundLight": "#F3F4F6",
  "backgroundNeutral": "#E8E8E8",
  "tableAccent": "#00197F",
  "good": "#4F6F17",
  "neutral": "#7D6100",
  "bad": "#B61E24",
  "maximum": "#00197F",
  "center": "#A17E00",
  "minimum": "#E8E8E8",
  "hyperlink": "#2A2D7F",
  "visualStyles": {
    "*": {
      "*": {
        "*": [
          {
            "fontFamily": "Segoe UI"
          }
        ],
        "title": [
          {
            "titleWrap": true,
            "fontColor": {
              "solid": {
                "color": "#0E2841"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "background": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "title": [
          {
            "show": true,
            "alignment": "center",
            "background": {
              "solid": {
                "color": "#00197F"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "title": [
          {
            "show": true,
            "alignment": "center",
            "background": {
              "solid": {
                "color": "#00197F"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "title": [
          {
            "show": true,
            "alignment": "center",
            "background": {
              "solid": {
                "color": "#00197F"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "columnChart": {
      "*": {
        "title": [
          {
            "show": true,
            "alignment": "center",
            "background": {
              "solid": {
                "color": "#00197F"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "title": [
          {
            "show": true,
            "alignment": "center",
            "background": {
              "solid": {
                "color": "#00197F"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    }
  },
  "textClasses": {
    "label": {
      "fontFace": "Segoe UI",
      "color": "#0E2841"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "color": "#0E2841"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "color": "#0E2841"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "color": "#0E2841"
    }
  }
}