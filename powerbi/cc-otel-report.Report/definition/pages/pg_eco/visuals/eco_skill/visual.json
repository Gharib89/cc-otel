{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.7.0/schema.json",
  "name": "eco_skill",
  "position": {
    "x": 16,
    "y": 72,
    "z": 5,
    "height": 300,
    "width": 406,
    "tabOrder": 5
  },
  "visual": {
    "visualType": "barChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "bridge_session_skill"
                    }
                  },
                  "Property": "skill_name"
                }
              },
              "queryRef": "bridge_session_skill.skill_name",
              "nativeQueryRef": "skill_name",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "bridge_session_skill"
                    }
                  },
                  "Property": "activations"
                }
              },
              "queryRef": "bridge_session_skill.activations",
              "nativeQueryRef": "activations"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Top skills'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
