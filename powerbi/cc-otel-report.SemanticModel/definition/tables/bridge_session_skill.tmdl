table bridge_session_skill

	column session_id
		dataType: string
		summarizeBy: none
		sourceColumn: session_id

		annotation SummarizationSetBy = Automatic

	column skill_name
		dataType: string
		summarizeBy: none
		sourceColumn: skill_name

		annotation SummarizationSetBy = Automatic

	column activations
		dataType: int64
		formatString: 0
		summarizeBy: sum
		sourceColumn: activations

		annotation SummarizationSetBy = Automatic

	partition bridge_session_skill = m
		mode: import
		source =
				let
				  Source = Value.NativeQuery(PostgreSQL.Database("ccotel-pg-interim.postgres.database.azure.com", "cc_otel"), "SELECT * FROM marts.bridge_session_skill")
				in
				  Source

	annotation PBI_ResultType = Table

