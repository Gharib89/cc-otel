	/// Roster/telemetry reconciliation bucket for the Data Health mismatch table (#124), model-side calc column, no migration.
	/// #294: rewritten to the seat-population taxonomy (#290) now that the roster is IS's and not fabricated from telemetry —
	/// "Off-roster identity" is reachable for the first time. Unknown-id stays first (spoofed/blank emails, #8): those have no
	/// resolvable seat, so folding them into off-roster would hide an ingest defect behind a licensing state.
	/// Recency is a fixed 28 days against the imported dim_date ceiling, matching the report's default relative-date window:
	/// a calculated column materialises at refresh and cannot read the date slicer.
	/// An untracked seat (one that has never emitted) is unreachable here by construction — dim_user is telemetry-only, so a
	/// never-emitting seat has no row. It belongs to the untracked-seat worklist read off dim_seat_current[telemetry_status] (#295).
	/// #321: [is_linked_identity] short-circuits the seat walk — a linked identity reaches its corporate seat through the
	/// re-pointed relationship but does not hold it, so it must keep reading "Off-roster identity" (ADR-0011).
	/// #346: the recency test reads [last_seen_date], not [last_seen] — Cutoff is a dim_date midnight, so a
	/// timestamptz operand shifted by the refreshing machine's UTC offset admitted an identity last seen late on
	/// the day *before* the cutoff as "Active seat".
	column 'Roster Status' =
			VAR Cutoff = MAX ( dim_date[date_day] ) - 27
			RETURN
			    SWITCH (
			        TRUE (),
			        dim_user[is_unknown] = TRUE (), "Unknown id",
			        dim_user[is_linked_identity]
			            || ISBLANK ( RELATED ( dim_seat_current[user_email] ) ), "Off-roster identity",
			        dim_user[last_seen_date] >= Cutoff, "Active seat",
			        "Dormant seat"
			    )
		dataType: string
		lineageTag: b1d70001-0000-4000-8000-000000000124
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column rls_email
		dataType: string
		lineageTag: 8d34c628-8895-495c-8bf7-570b62bac01e
		summarizeBy: none
		sourceColumn: rls_email

		annotation SummarizationSetBy = Automatic

	/// The off-roster flag that survives the link (ADR-0011), model calc column so it materialises at refresh and is
	/// viewer-independent. Both relationships out of dim_user hang off [rls_email], so for a linked identity
	/// RELATED ( dim_seat_current[...] ) resolves through a seat it does not hold — every site reading that as
	/// "holds a seat" guards on this instead of on ISBLANK alone. #320 sets rls_email = user_email when unlinked,
	/// so this is FALSE for every ordinary identity.
	column is_linked_identity = dim_user[user_email] <> dim_user[rls_email]
		dataType: boolean
		lineageTag: d3210001-0000-4000-8000-000000000321
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// #345/#346: the date-typed twin of [first_seen], and the only correct operand for a dim_date[date_day]
	/// boundary. marts.dim_user computes it as a Postgres `date`, which the connector imports as a naive
	/// midnight exactly like date_day, where the timestamptz [first_seen] renders in the refreshing machine's
	/// local zone (+3 on the Cairo fleet) and lands a late-evening identity on the following day. [first_seen]
	/// stays for display (pg_adopt's roster table, pg_user_detail's cards) — a person reads a timestamp in
	/// their own zone; a boundary must not.
	column first_seen_date
		dataType: dateTime
		formatString: Short Date
		lineageTag: d3460001-0000-4000-8000-000000000346
		summarizeBy: none
		sourceColumn: first_seen_date

		annotation SummarizationSetBy = Automatic

	/// The [last_seen] counterpart, same reason as [first_seen_date]: recency cutoffs compare date-to-date.
	column last_seen_date
		dataType: dateTime
		formatString: Short Date
		lineageTag: d3460002-0000-4000-8000-000000000346
		summarizeBy: none
		sourceColumn: last_seen_date

		annotation SummarizationSetBy = Automatic

	partition dim_user = m
		mode: import
		source =
				let
				  Source = Value.NativeQuery(PostgreSQL.Database("ccotel-pg-interim.postgres.database.azure.com", "cc_otel"), "SELECT * FROM marts.dim_user")
				in
				  Source

	annotation PBI_ResultType = Table

