table mart_refresh_log

	column id
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: id

		annotation SummarizationSetBy = Automatic

	column mart
		dataType: string
		summarizeBy: none
		sourceColumn: mart

		annotation SummarizationSetBy = Automatic

	column started
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: started

		annotation SummarizationSetBy = Automatic

	column finished
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: finished

		annotation SummarizationSetBy = Automatic

	column row_count
		dataType: int64
		formatString: 0
		summarizeBy: sum
		sourceColumn: row_count

		annotation SummarizationSetBy = Automatic

	partition mart_refresh_log = m
		mode: import
		source =
				let
				  Source = PostgreSQL.Database("ccotel-pg-interim.postgres.database.azure.com", "cc_otel"),
				  #"Navigation 1" = Source{[Schema = "marts", Item = "mart_refresh_log"]}[Data]
				in
				  #"Navigation 1"

	annotation PBI_ResultType = Table

