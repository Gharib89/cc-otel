/// Current seat dimension (#294) — one row per person holding an open seat, from marts.dim_seat_current (ADR-0009).
/// Occupies the one-side relationship slot the fabricated seat_roster held, so the roster-reaching measures survive a rename.
/// Sourced from IS's roster, never from telemetry: it holds the full licensed population (184), not the instrumented one.
/// dim_user_to_dim_seat_current is plain many:1 with this table on the to-side, never 1:1 — a fromCardinality:one edge into
/// dim_user, which sits on the OrgScope security-filter chain, makes Desktop reject the model silently (#118).
table dim_seat_current
	lineageTag: d2940101-0000-4000-8000-000000000294

	column user_email
		dataType: string
		isKey
		lineageTag: d2940102-0000-4000-8000-000000000294
		summarizeBy: none
		sourceColumn: user_email

		annotation SummarizationSetBy = Automatic

	column seat_tier
		dataType: string
		lineageTag: d2940103-0000-4000-8000-000000000294
		summarizeBy: none
		sourceColumn: seat_tier

		annotation SummarizationSetBy = Automatic

	column anthropic_org_name
		dataType: string
		lineageTag: d2940104-0000-4000-8000-000000000294
		summarizeBy: none
		sourceColumn: anthropic_org_name

		annotation SummarizationSetBy = Automatic

	column valid_from
		dataType: dateTime
		formatString: Short Date
		lineageTag: d2940105-0000-4000-8000-000000000294
		summarizeBy: none
		sourceColumn: valid_from

		annotation SummarizationSetBy = Automatic

	/// Telemetry-observation bucket for the untracked-seat worklist (#295), model-side calc column, no migration.
	/// Named for what it observes, never for what it implies: "Never emitted" today means the installer has not
	/// reached that machine (17 tracked machines against 184 seats), and once rollout completes the identical
	/// column will mean genuinely idle, with no code change and nothing to alert anyone — which is why the
	/// install beacon is the real fix and this bucket only ever claims an observation.
	/// Evaluated against dim_user (telemetry-only) and never vw_UserBasicInfo, so the worklist needs no
	/// relationship traversal to the HR view. #301 does put this table on the OrgScope security-filter
	/// chain, which does not reach the expression: a calculated column materialises at refresh, before
	/// any role is evaluated, so the bucket is always computed over the whole roster. RLS decides which
	/// of those rows a viewer sees, never how one is bucketed.
	/// Deliberately all-time, not window-aware: a calculated column evaluates under empty filter context, so this
	/// is the ever-emitted set. [Instrumented Seats] is bounded on first_seen instead, so the exec card's remainder
	/// moves with the date slicer while this worklist does not — they agree only while the window spans every
	/// first_seen. Current-state is the right basis for a rollout list; the measure's is right for a windowed KPI.
	/// Depends on the *base* column dim_user[user_email], which is what keeps the dependency graph acyclic:
	/// dim_user['Roster Status'] reaches back here through RELATED ( dim_seat_current[user_email] ), also a base
	/// column. Repointing either at the other's *calculated* column closes the loop, and it fails at refresh
	/// rather than at edit time — neither TMDL parse nor Desktop load catches it.
	column telemetry_status =
			IF (
			    dim_seat_current[user_email] IN VALUES ( dim_user[user_email] ),
			    "Instrumented",
			    "Never emitted"
			)
		dataType: string
		lineageTag: d2950105-0000-4000-8000-000000000295
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition dim_seat_current = m
		mode: import
		source =
				let
				  Source = Value.NativeQuery(PostgreSQL.Database(#"PgHost", #"PgDatabase"), "SELECT * FROM marts.dim_seat_current")
				in
				  Source

	annotation PBI_ResultType = Table

