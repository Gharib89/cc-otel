table dim_date
	lineageTag: c539c9e2-de5b-4050-81e7-87dfccef8b1c
	dataCategory: Time

	column date_day
		dataType: dateTime
		isKey
		formatString: Short Date
		lineageTag: dddd719d-ab3f-4517-b733-e62165de55aa
		summarizeBy: none
		sourceColumn: date_day

		annotation SummarizationSetBy = Automatic

	column year
		dataType: int64
		formatString: 0
		lineageTag: 2405a4d0-fc01-4dbb-adaf-a5761758cb18
		summarizeBy: none
		sourceColumn: year

		annotation SummarizationSetBy = Automatic

	column quarter
		dataType: int64
		formatString: 0
		lineageTag: fe6bd367-79af-462f-b1ad-f088632018dc
		summarizeBy: none
		sourceColumn: quarter

		annotation SummarizationSetBy = Automatic

	column month
		dataType: int64
		formatString: 0
		lineageTag: 77c30e3e-af36-4bd8-9a34-9235eb4a9d54
		summarizeBy: none
		sourceColumn: month

		annotation SummarizationSetBy = Automatic

	column month_name
		dataType: string
		lineageTag: 3c922f59-f3ec-4660-95be-803a991553f4
		summarizeBy: none
		sourceColumn: month_name

		annotation SummarizationSetBy = Automatic

	column day_of_month
		dataType: int64
		formatString: 0
		lineageTag: 9de16db0-e953-4cf0-93f1-1c19a786761c
		summarizeBy: none
		sourceColumn: day_of_month

		annotation SummarizationSetBy = Automatic

	column iso_dow
		dataType: int64
		formatString: 0
		lineageTag: 5a4b1a10-fe5f-438d-8407-9527585a3148
		summarizeBy: none
		sourceColumn: iso_dow

		annotation SummarizationSetBy = Automatic

	column day_name
		dataType: string
		lineageTag: 402a074d-33fc-4a62-86b2-71e0a71e9ea1
		summarizeBy: none
		sourceColumn: day_name

		annotation SummarizationSetBy = Automatic

	column is_weekend
		dataType: boolean
		lineageTag: a8ee62c3-3b11-4c8a-a75b-a2dcca518f5c
		summarizeBy: none
		sourceColumn: is_weekend

		annotation SummarizationSetBy = Automatic

	column iso_week
		dataType: int64
		formatString: 0
		lineageTag: 6e0005e0-5f6f-45d6-a478-352961f2b5be
		summarizeBy: none
		sourceColumn: iso_week

		annotation SummarizationSetBy = Automatic

	/// ISO week bucket (Mon start) for the WAU trend — model-side calc column per #117, no migration.
	column week_start = dim_date[date_day] - ( dim_date[iso_dow] - 1 )
		dataType: dateTime
		formatString: Short Date
		lineageTag: ed644923-e46c-4893-99fe-652e71edeb83
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Week axis label; carries the week-start date because the ISO week number alone collides across years (#117).
	column week_label = FORMAT ( dim_date[week_start], "d mmm yy" )
		dataType: string
		lineageTag: 62b98f5c-64a0-49a9-8965-8d4299015664
		summarizeBy: none
		sortByColumn: week_start

		annotation SummarizationSetBy = Automatic

	/// Month bucket for the MAU trend — model-side calc column mirroring week_start (#177), no migration.
	column month_start = DATE ( YEAR ( dim_date[date_day] ), MONTH ( dim_date[date_day] ), 1 )
		dataType: dateTime
		formatString: Short Date
		lineageTag: 3f1c8a02-6d4e-4b7a-9c15-0a2e7b6d1f44
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Month axis label; carries the month-start date so the label sorts chronologically across years (#177).
	column month_label = FORMAT ( dim_date[month_start], "mmm yy" )
		dataType: string
		lineageTag: 9b7e2d51-4a8c-46f3-bd90-1c6f8a3e5d72
		summarizeBy: none
		sortByColumn: month_start

		annotation SummarizationSetBy = Automatic

	partition dim_date = m
		mode: import
		source =
				let
				  Source = Value.NativeQuery(PostgreSQL.Database(#"PgHost", #"PgDatabase"), "SELECT * FROM marts.dim_date")
				in
				  Source

	annotation PBI_ResultType = Table

