	/// Root-to-node management chain (each node = a normalized Email), used by the OrgScope RLS role.
	column ManagementPath = PATH(vw_UserBasicInfo[Email], vw_UserBasicInfo[ManagerEmailClean])
		dataType: string
		isHidden
		lineageTag: c43f554a-55db-4fc7-9e21-29da58b0b345
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// ManagerEmail cleaned so PATH() (which needs a bare column and rejects cycles + dangling parents)
	/// always resolves. Blank when: the row is a service/shared account that must not sit in the people
	/// hierarchy (they create management cycles — see the exclusion list; extend it as more surface), or
	/// the ManagerEmail isn't itself an Email in this table (org top / external manager). Blank = a root.
	/// STOPGAP for the #10 "acyclic manager chain" contract the HR view currently violates; durable fix
	/// is upstream in vw_UserBasicInfo.
	column ManagerEmailClean = IF(NOT(vw_UserBasicInfo[Email] IN {"internal.application@itworx.com"}) && vw_UserBasicInfo[ManagerEmail] IN VALUES(vw_UserBasicInfo[Email]), vw_UserBasicInfo[ManagerEmail])
		dataType: string
		isHidden
		lineageTag: 8d883cde-4859-464b-85f7-1979618f8a3d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition vw_UserBasicInfo = m
		mode: import
		source =
				let
				  Source = Sql.Database("itxdatainteg-prod.database.windows.net", "EmployeeSchema"),
				  #"Navigation 1" = Source{[Schema = "dbo", Item = "vw_UserBasicInfo"]}[Data],
				  // STOPGAP: dbo.vw_UserBasicInfo returns duplicate Email rows, which breaks the
				  // one-side uniqueness of the dim_user_to_vw_UserBasicInfo relationship at refresh.
				  // Durable fix is upstream in the HR view; this mirrors the ManagerEmailClean stopgap
				  // in the same table. Sort by all columns (Email first) so the surviving row per Email
				  // is deterministic across refreshes, buffer to lock that order, then keep one row per Email.
				  #"Sorted Rows" = Table.Sort(#"Navigation 1", {
					{"Email", Order.Ascending},
					{"DisplayName", Order.Ascending},
					{"Organization", Order.Ascending},
					{"Department", Order.Ascending},
					{"Division", Order.Ascending},
					{"BusinessUnit", Order.Ascending},
					{"Account", Order.Ascending},
					{"ManagerEmail", Order.Ascending},
					{"ManagerFirstName", Order.Ascending},
					{"ManagerLastName", Order.Ascending}
				  }),
				  #"Buffered Rows" = Table.Buffer(#"Sorted Rows"),
				  #"Deduped Email" = Table.Distinct(#"Buffered Rows", {"Email"})
				in
				  #"Deduped Email"

