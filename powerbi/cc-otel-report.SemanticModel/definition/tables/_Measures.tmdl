table _Measures
	lineageTag: 41db967c-6b17-4d4e-9ae2-f63f216ae1d1

	/// Report thresholds live in DAX (not the marts) so a change is a measure edit, never a migration (#9/#27).
	measure 'Limit-Hit Threshold Pct' = 90
		formatString: 0
		displayFolder: Thresholds
		lineageTag: ab03459a-9aaa-4ecf-b90c-81c378d024fc

	/// Fresh under 24h (daily refresh); Delayed 24h-7d; Stale beyond. Thresholds in DAX, not marts (#9/#27).
	measure 'Freshness Amber Hours' = 24
		formatString: 0
		displayFolder: Thresholds
		lineageTag: 54b2239c-b99d-45ef-bae6-41bcdef482b4

	measure 'Freshness Red Hours' = 168
		formatString: 0
		displayFolder: Thresholds
		lineageTag: b6055541-5d85-4a6a-b268-5f526649c39f

	/// Distinct users with any activity in context — "any signal that day", no minimum-activity gate (#9).
	measure 'Active Users' = DISTINCTCOUNT(fact_session_daily[user_email])
		formatString: #,##0
		displayFolder: Adoption
		lineageTag: 55aa8e20-36db-4ca3-9484-07abdea77d38

	measure 'Active Days' = DISTINCTCOUNT(fact_session_daily[activity_date])
		formatString: #,##0
		displayFolder: Adoption
		lineageTag: 77795e6a-9794-4abb-b9e4-0b53e6ab4690

	measure 'Total Sessions' = DISTINCTCOUNT(fact_session[session_id])
		formatString: #,##0
		displayFolder: Adoption
		lineageTag: 41898052-d590-4540-b200-6a9bc8f635ee

	measure 'Total Prompts' = SUM(fact_session_daily[prompts])
		formatString: #,##0
		displayFolder: Adoption
		lineageTag: c32123b6-c301-441d-93fd-98d398cbe178

	measure 'Total Input Tokens' = SUM(fact_api_usage[input_tokens])
		formatString: #,##0
		displayFolder: API Usage
		lineageTag: 43bc0efa-c276-4d09-8afc-3c2965a3be2b

	measure 'Total Output Tokens' = SUM(fact_api_usage[output_tokens])
		formatString: #,##0
		displayFolder: API Usage
		lineageTag: 516734d9-04df-4e4a-8d08-b91ca2468828

	measure 'Total Requests' = SUM(fact_api_usage[request_count])
		formatString: #,##0
		displayFolder: API Usage
		lineageTag: 8a82517d-97c2-4dae-9141-b174a81cb6a0

	/// Utilization windows at or above the limit-hit threshold, over all 5h windows in context.
	/// Grain is user × window_type × window_end × segment_no, so collapse reset-split segments to
	/// one row per window instance first (a window hit the limit if any segment's peak_pct did).
	measure 'Limit-Hit Rate' =
			VAR Threshold = [Limit-Hit Threshold Pct]
			VAR FiveHWindows =
			    ADDCOLUMNS (
			        SUMMARIZE (
			            CALCULATETABLE ( fact_usage_window, fact_usage_window[window_type] = "5h" ),
			            fact_usage_window[user_email],
			            fact_usage_window[window_end]
			        ),
			        "@PeakInWindow", CALCULATE ( MAX ( fact_usage_window[peak_pct] ) )
			    )
			RETURN
			    DIVIDE (
			        COUNTROWS ( FILTER ( FiveHWindows, [@PeakInWindow] >= Threshold ) ),
			        COUNTROWS ( FiveHWindows )
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Utilization
		lineageTag: d69a9564-55ce-4b96-b926-f5ec8ea4c795

	/// Mean closing utilization across window instances. end_pct/peak_pct are stored 0-100 (percent points), so
	/// collapse each window's reset-split segments to its closing reading — MAX(end_pct); segments are cumulative
	/// snapshots within the window, so their sum grossly overstates and the old Σ-of-segments produced 1000%+ values.
	/// A window instance is user × window_type × window_end. Divide by 100 to a ratio for the 0.0% format.
	/// (Corrects the #117/#9 "sum segments, report >100% as-is" stance — impossible values, per live review.)
	measure 'Utilization Intensity' =
			VAR PerWindow =
			    ADDCOLUMNS (
			        SUMMARIZE (
			            fact_usage_window,
			            fact_usage_window[user_email],
			            fact_usage_window[window_type],
			            fact_usage_window[window_end]
			        ),
			        "@CloseEndPct", CALCULATE ( MAX ( fact_usage_window[end_pct] ) )
			    )
			RETURN
			    DIVIDE ( AVERAGEX ( PerWindow, [@CloseEndPct] ), 100 )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Utilization
		lineageTag: 81068fa0-8934-4b90-aa99-797baea5d229

	/// Mean hourly utilization for the hour-of-day heatmap. fact_utilization_hourly[avg_pct] is the
	/// per user x window_type x hour mean closing utilization, stored 0-100 (percent points); average it
	/// across the hour-of-day bucket in context and divide by 100 for the 0.0% format. Split by window_type.
	measure 'Hourly Utilization Intensity' = DIVIDE ( AVERAGE ( fact_utilization_hourly[avg_pct] ), 100 )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Utilization
		lineageTag: b2c3d4e5-0175-4f6a-9b0c-1d2e3f4a5b6c

	/// How close to the ceiling a typical dev gets (#323) — the mean, across users, of each user's own
	/// worst window in the period. Plotted weekly and split by window_type: 5h is the rate-limit window
	/// that actually bites, 7d the subscription envelope. peak_pct is stored 0-100, so divide for 0.0%.
	///
	/// Unlike [Utilization Intensity] this needs no explicit window-instance collapse. That collapse
	/// exists because reset-split segments are cumulative snapshots, so summing or averaging them
	/// overstates — but MAX is idempotent over the split (max of per-window maxima is the max), so
	/// grouping straight to user × window_type gives the identical number with half the DAX.
	///
	/// Rejected alternatives, recorded so they are not re-tried: the org-wide MAX(peak_pct) saturates
	/// near 100% every week once ~50 seats are in play and renders as a flat line; P95 of window peaks
	/// is viable but answers a different question than the page asks.
	measure 'Peak Utilization %' =
			VAR PerUser =
			    ADDCOLUMNS (
			        SUMMARIZE (
			            fact_usage_window,
			            fact_usage_window[user_email],
			            fact_usage_window[window_type]
			        ),
			        "@UserPeak", CALCULATE ( MAX ( fact_usage_window[peak_pct] ) )
			    )
			RETURN
			    DIVIDE ( AVERAGEX ( PerUser, [@UserPeak] ), 100 )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Utilization
		lineageTag: b3230001-0000-4000-8000-000000000323

	/// The two window_type series for cht_peak_util (#323), split as explicit measures rather than a
	/// Series/legend projection — the report has no Series role anywhere and states its series this way
	/// (see [Input Tokens (Weekly)] / [Output Tokens (Weekly)]), which also gives the legend real names.
	measure 'Peak Utilization % (5h)' = CALCULATE ( [Peak Utilization %], fact_usage_window[window_type] = "5h" )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Utilization
		lineageTag: b3230002-0000-4000-8000-000000000323

	measure 'Peak Utilization % (7d)' = CALCULATE ( [Peak Utilization %], fact_usage_window[window_type] = "7d" )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Utilization
		lineageTag: b3230003-0000-4000-8000-000000000323

	measure 'Tool Acceptance Rate' =
			DIVIDE (
			    CALCULATE ( SUM ( fact_edit_decision[decision_count] ), fact_edit_decision[decision] = "accept" ),
			    SUM ( fact_edit_decision[decision_count] )
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Tool Quality
		lineageTag: d2bb363b-cd63-4aa4-84eb-169753d92097

	/// Share of tool_result events that succeeded (#174, fact_tool_outcome P2). Pair with p95 latency — reliability failures kill adoption.
	measure 'Tool Success Rate' =
			DIVIDE (
			    SUM ( fact_tool_outcome[success_count] ),
			    SUM ( fact_tool_outcome[tool_call_count] )
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Tool Quality
		lineageTag: d60a6272-71f2-4cbf-a7e7-ef12be7cbed1

	/// Mean of the per-session/day p95 tool latency (ms). True cross-session p95 is unrecoverable from the pre-aggregated mart, so this averages the per-grain p95 — read as a tail-latency trend, not an exact percentile (#174).
	measure 'Tool p95 Latency (ms)' = AVERAGE ( fact_tool_outcome[duration_p95_ms] )
		formatString: #,##0
		displayFolder: Tool Quality
		lineageTag: 76fdd088-f0fd-4122-8082-1a74ea07084f

	/// api_error events over api_request events (#174, fact_api_error_rate P3). Ops signal on Data Health, not exec. Recomputed from counts, not an average of daily rates.
	measure 'API Error Rate' =
			DIVIDE (
			    SUM ( fact_api_error_rate[api_error_count] ),
			    SUM ( fact_api_error_rate[api_request_count] ) + SUM ( fact_api_error_rate[api_error_count] )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Ingest Health
		lineageTag: d69888b0-c91f-48a5-a793-bf620d5fe29b

	/// Import-mode caveat: staleness includes the daily report-refresh lag, not just pipeline silence.
	measure 'Hours Since Last Signal' =
			VAR LastSignal = MAX ( fact_api_usage[last_event_ts] )
			RETURN
			    IF ( ISBLANK ( LastSignal ), BLANK (), DATEDIFF ( LastSignal, NOW (), HOUR ) )
		formatString: #,##0
		displayFolder: Ingest Health
		lineageTag: ce8455de-52fb-4851-9ba7-ae6bf293d1bb

	measure 'Data Freshness Status' =
			VAR H = [Hours Since Last Signal]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( H ), "No data",
			        H < [Freshness Amber Hours], "Fresh",
			        H <= [Freshness Red Hours], "Amber",
			        "Red"
			    )
		displayFolder: Ingest Health
		lineageTag: 07e67adf-426d-478d-be5e-0be7551fb58c

	/// Second freshness signal — catches pg_cron death independently of the pipeline-silence signal (#9).
	measure 'Last Mart Refresh' = MAX(mart_refresh_log[finished])
		formatString: "Mart " dd MMM HH:mm
		displayFolder: Ingest Health
		lineageTag: 833b49f9-2225-4543-aaa6-a8a2b971b811

	/// #197 snapshot-calendar lag: calendar days the imported dim_date snapshot trails the viewer clock.
	/// Import-mode datasets snapshot dim_date (dense to CURRENT_DATE) at refresh; a weekend/holiday refresh
	/// gap leaves MAX(dim_date) behind TODAY(), shrinking the Now()-anchored relative-date slicer window
	/// (#165). Isolates snapshot lag from telemetry quiet, which [Hours Since Last Signal] conflates; 0 on a
	/// healthy same-day refresh. Consumed by [Data Freshness Badge] to surface the >= 2-day case.
	measure 'Snapshot Calendar Lag' = INT ( TODAY () - MAX ( dim_date[date_day] ) )
		formatString: #,##0
		displayFolder: Ingest Health
		lineageTag: a1970001-0000-4000-8000-000000000197

	/// #305 tooltip payload: the finding's JSON detail, lifted out of the tbl_dq grid so the table keeps
	/// only scannable columns. SELECTEDVALUE, not CONCATENATEX — a tooltip page evaluates under the hovered
	/// row's filter context, so exactly one finding is ever in scope. Guarded on finding_type rather than on
	/// details itself, so a finding that genuinely recorded no payload still says so instead of rendering an
	/// empty card indistinguishable from a failed hover.
	measure 'DQ Detail Payload' =
			IF (
			    NOT ISBLANK ( SELECTEDVALUE ( dq_finding[finding_type] ) ),
			    COALESCE ( SELECTEDVALUE ( dq_finding[details] ), "(no payload recorded)" )
			)
		displayFolder: Ingest Health
		lineageTag: d3050001-0000-4000-8000-000000000305

	/// #305 tooltip header: the finding's identity in one line, so the tooltip names what it is showing
	/// without a second visual competing for a 320px canvas.
	measure 'DQ Finding Header' =
			VAR FindingType = SELECTEDVALUE ( dq_finding[finding_type] )
			VAR Detected = SELECTEDVALUE ( dq_finding[detected_at] )
			VAR Affected = SUM ( dq_finding[row_count] )
			VAR AffectedClause =
			    IF (
			        ISBLANK ( Affected ),
			        "",
			        "  ·  " & FORMAT ( Affected, "#,##0" ) & IF ( Affected = 1, " row", " rows" )
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( FindingType ),
			        FindingType & "  ·  detected " & FORMAT ( Detected, "dd MMM HH:mm" ) & AffectedClause
			    )
		displayFolder: Ingest Health
		lineageTag: d3050002-0000-4000-8000-000000000305

	/// Report-data-contract user-page fields (#28). commits/prs are doubles in the daily mart.
	measure 'Total Commits' = SUM(fact_session_daily[commits])
		formatString: #,##0
		displayFolder: Productivity
		lineageTag: a1c00001-0000-4000-8000-000000000028

	measure 'Total PRs' = SUM(fact_session_daily[prs])
		formatString: #,##0
		displayFolder: Productivity
		lineageTag: a1c00002-0000-4000-8000-000000000028

	/// LOC = added + removed: the lines_of_code.count metric splits into type=added/removed rows (#9).
	measure 'Total Lines of Code' = SUM(fact_session_daily[loc_added]) + SUM(fact_session_daily[loc_removed])
		formatString: #,##0
		displayFolder: Productivity
		lineageTag: a1c00003-0000-4000-8000-000000000028

	/// Per-active-user output ratio (#176): normalizes throughput by the active population so the trend reflects intensity, not headcount.
	measure 'Commits per Active User' = DIVIDE ( [Total Commits], [Active Users] )
		formatString: #,##0.0
		displayFolder: Productivity
		lineageTag: a1c00005-0000-4000-8000-000000000176

	measure 'PRs per Active User' = DIVIDE ( [Total PRs], [Active Users] )
		formatString: #,##0.0
		displayFolder: Productivity
		lineageTag: a1c00006-0000-4000-8000-000000000176

	/// Weekly-gated ratio for the trend: divides the partial-week-suppressed numerator so the line matches the Commits/PRs and LoC trends (no spurious final partial week).
	measure 'Commits per Active User (Weekly)' = DIVIDE ( [Commits (Weekly)], [Active Users] )
		formatString: #,##0.0
		displayFolder: Trends
		lineageTag: a1c00007-0000-4000-8000-000000000176

	measure 'PRs per Active User (Weekly)' = DIVIDE ( [PRs (Weekly)], [Active Users] )
		formatString: #,##0.0
		displayFolder: Trends
		lineageTag: a1c00008-0000-4000-8000-000000000176

	/// Mean session length (contract "Avg session duration"), in minutes.
	measure 'Avg Session Duration' = AVERAGE(fact_session[duration_s]) / 60
		formatString: #,##0.0 "min"
		displayFolder: Adoption
		lineageTag: a1c00005-0000-4000-8000-000000000028

	/// Drives the freshness pill's label text colour, on all six report pages (#28): green/amber/red per
	/// [Data Freshness Status], grey for no data. Binds at objects.labels[].properties.color in every
	/// crd_fresh -- never a fill, so the text floor is what applies. Hex values mirror the AIWorx.json
	/// good/neutral/bad tokens (#312 retired the root theme.json this comment used to name). #315
	/// darkened good/neutral to clear the 4.5:1 floor -- the pill's chip background is #E8E8E8 rather
	/// than the card surface, so it bites harder here (good was 2.72:1 on the chip, now 4.74:1). The
	/// no-data branch takes the label grey for the same reason: tertiary #9AA0AA managed only 2.15:1 on
	/// that chip, and #5A6473 is already what the delta measures use for their no-signal state.
	measure 'Freshness Color' =
			SWITCH (
			    [Data Freshness Status],
			    "Fresh", "#4F6F17",
			    "Amber", "#7D6100",
			    "Red", "#B61E24",
			    "#5A6473"
			)
		displayFolder: Ingest Health
		lineageTag: a1c00006-0000-4000-8000-000000000028

	/// Distinct client-asserted emails flagged unresolved (#28 ingest-health page). Spoofing/blank emails
	/// land as is_unknown in dim_user (#8); surfaced as a count, never silently dropped.
	measure 'Unknown Email Users' = CALCULATE ( DISTINCTCOUNT ( dim_user[user_email] ), dim_user[is_unknown] = TRUE )
		formatString: #,##0
		displayFolder: Ingest Health
		lineageTag: a1c00007-0000-4000-8000-000000000028

	/// #117 measure layer, #165 relative-date rewrite. The window comes from the report's relative-date
	/// slicer (default last 28 days); "PP" = the immediately preceding equal-length window. Headline
	/// (Seat ROI) numerators are roster-matched only; plain [Active Users] stays for non-ROI contexts.
	/// #294: the licensed-seat denominator, counted over the daily seat fact so it is point-in-time correct and
	/// responds to the date slicer — the seats open in the selected window (184 today), not the observed-user
	/// count the fabricated roster returned by construction.
	/// The bridge exists because fact_seat_day has no relationship to dim_seat_current, so a selection made on the
	/// dimension — the sl_tier slicers, the seat-trend and worklist visuals — reaches the fact only through TREATAS. It carries
	/// user_email, not seat_tier, for two reasons: every dimension column then propagates (tier, org, the seat's own
	/// email) rather than only the one an ISFILTERED guard happened to name; and both series of a per-tier visual end
	/// up on the same tier basis. [Active Roster Users] receives the tier through the dim_user relationship, i.e.
	/// today's tier, so counting seat-days by the tier in force *each day* would split one person across two
	/// categories the moment their tier changed mid-window and drive per-tier [Idle Seats] negative.
	/// KEEPFILTERS so an outer tier filter (see [Instrumented Seat Cost]) intersects rather than being overridden.
	/// This is the *licensed* population. Every ratio whose numerator comes from telemetry divides by
	/// [Instrumented Seats] instead — see the note there.
	measure 'Paid Seats' =
			CALCULATE (
			    DISTINCTCOUNT ( fact_seat_day[user_email] ),
			    KEEPFILTERS ( TREATAS ( VALUES ( dim_seat_current[user_email] ), fact_seat_day[user_email] ) )
			)
		formatString: #,##0
		displayFolder: Seat ROI
		lineageTag: b9365732-93a2-497e-b49d-0215e0fe0d5e

	/// Licensed seats telemetry has actually reached: the open seats in the window whose email also appears in
	/// dim_user (telemetry-only). Not the licensed population (184) and not the window's actives (19) — a seat
	/// instrumented but quiet in the window still counts, because the install did reach that machine.
	/// #294: the honest denominator for every ratio with a telemetry-derived numerator. [Value Consumed] and
	/// [Active Roster Users] can only be observed on instrumented seats, so dividing either by [Paid Seats] would
	/// measure the instrumentation gap (17 tracked machines against 184 seats) and report it as developer
	/// behaviour. ADR-0009 makes the rule explicit: these measures must stay on tracked members.
	/// Composed over [Paid Seats] so the seat bridge is not duplicated; the extra TREATAS is needed because
	/// fact_seat_day is deliberately unrelated to dim_user — most licensed seats have no dim_user row at all.
	/// The licensed-versus-instrumented share itself is [Instrumented Seat Share], not this measure (#295).
	/// The first_seen bound makes the count date-aware, which the emitter side is not otherwise: dim_user has no
	/// relationship to dim_date, so a bare VALUES( dim_user[user_email] ) is the all-time emitter set in every
	/// window, and a shifted window (the PP measures) would credit machines the installer had not yet reached.
	/// Unguarded it reported the prior 28 days as 20 instrumented seats when 13 of those machines had never emitted
	/// by then, turning a flat ~-5 pp into a +60 pp jump on the exec hero.
	measure 'Instrumented Seats' =
			VAR WindowEnd = MAX ( dim_date[date_day] )
			VAR Reached =
			    CALCULATETABLE (
			        VALUES ( dim_user[user_email] ),
			        KEEPFILTERS ( dim_user[first_seen] <= WindowEnd )
			    )
			RETURN
			    CALCULATE (
			        [Paid Seats],
			        KEEPFILTERS ( TREATAS ( Reached, fact_seat_day[user_email] ) )
			    )
		formatString: #,##0
		displayFolder: Seat ROI
		lineageTag: d2940301-0000-4000-8000-000000000294

	/// Coverage: the share of the licensed population telemetry has reached (#295). The one ratio in Seat ROI that
	/// divides by [Paid Seats] rather than [Instrumented Seats] — measuring the instrumentation gap is the whole
	/// point of it, where every other Seat ROI ratio exists to keep that gap out of a behavioural number.
	measure 'Instrumented Seat Share' = DIVIDE ( [Instrumented Seats], [Paid Seats] )
		formatString: 0.0%
		displayFolder: Seat ROI
		lineageTag: d2950101-0000-4000-8000-000000000295

	/// Report-display helper: the coverage card's detail line, carrying the denominator the headline count omits.
	/// Blank when the window holds no seat-days, rather than rendering "of  licensed seats".
	measure 'Seat Coverage Detail' =
			IF (
			    NOT ISBLANK ( [Paid Seats] ),
			    "of " & FORMAT ( [Paid Seats], "#,##0" ) & " licensed seats · "
			        & FORMAT ( [Instrumented Seat Share], "0.0%" ) & " coverage"
			)
		displayFolder: Seat ROI
		lineageTag: d2950102-0000-4000-8000-000000000295

	/// Report-display helper: the coverage card's subtitle, and the reason the card is titled coverage and not
	/// adoption (#295). A seat with no telemetry has not been observed idle — it has not been observed at all, and
	/// the installer demonstrably has not reached every machine. Without this line 20 of 184 reads as developers
	/// ignoring the tool, and that reading leads to the opposite action from the true one (finish the rollout).
	/// Retire it once the install beacon lands and "never emitted" genuinely means idle.
	measure 'Seat Coverage Note' =
			IF (
			    NOT ISBLANK ( [Paid Seats] ),
			    "Install status is unknown for the remaining "
			        & FORMAT ( [Paid Seats] - [Instrumented Seats], "#,##0" ) & " seats"
			)
		displayFolder: Seat ROI
		lineageTag: d2950103-0000-4000-8000-000000000295

	/// How long the seat has been held, for the untracked-seat worklist (#295). Measured against the query clock
	/// (TODAY() resolves server-side, in the capacity timezone — not the viewer's) rather than the imported
	/// dim_date ceiling, because the question it answers — how long has IS been paying for a machine the installer
	/// never reached — is asked in real time and a stale snapshot must not shrink it. Note the model therefore
	/// carries two clocks: this one, and dim_user['Roster Status']'s refresh-frozen MAX ( dim_date[date_day] ).
	/// MIN, not MAX: identical at the one-seat grain the worklist renders, but at any coarser grain MAX would
	/// silently answer the opposite question — the newest assignment, i.e. the *shortest* tenure — so a totals row
	/// or a tier rollup would report the least urgent seat as the headline. MIN keeps "the longest-held untracked
	/// seat has been paid for N days" true at every grain, which is the number the worklist exists to surface.
	measure 'Days Since Assignment' =
			VAR Oldest = MIN ( dim_seat_current[valid_from] )
			RETURN
			    IF ( NOT ISBLANK ( Oldest ), INT ( TODAY () - Oldest ) )
		formatString: #,##0
		displayFolder: Seat ROI
		lineageTag: d2950104-0000-4000-8000-000000000295

	/// Roster-matched distinct actives; the window comes from the report's relative-date slicer (#165),
	/// not DAX (#117: off-roster identities excluded from the headline, surfaced on Data Health instead).
	measure 'Active Roster Users' =
			CALCULATE (
			    DISTINCTCOUNT ( fact_session_daily[user_email] ),
			    FILTER ( dim_user, NOT ISBLANK ( RELATED ( dim_seat_current[user_email] ) ) )
			)
		formatString: #,##0
		displayFolder: Seat ROI
		lineageTag: cda3f313-b54b-4371-84fe-ca61eb65e058

	/// Prior equal-length window (#165): same day-count as the current selection, immediately before it.
	measure 'Active Roster Users PP' =
			VAR Days = COUNTROWS ( dim_date )
			VAR FirstDay = MIN ( dim_date[date_day] )
			RETURN
			    CALCULATE (
			        [Active Roster Users],
			        DATESBETWEEN ( dim_date[date_day], FirstDay - Days, FirstDay - 1 )
			    )
		formatString: #,##0
		isHidden
		displayFolder: Seat ROI\Support
		lineageTag: 402883f1-9edf-442d-ba50-a3e8e88fb7cd

	/// The seat-ROI hero KPI: roster-matched actives (selected window) / instrumented seats.
	/// #294: divides by [Instrumented Seats], not [Paid Seats]. Over the licensed population this reads 10% and
	/// measures rollout coverage while being titled utilization — two readings that lead to opposite actions
	/// (#295). Against instrumented seats it stays what its name claims: of the seats we can observe, how many
	/// were used. Coverage is #295's own card.
	measure 'Seat Utilization %' = DIVIDE ( [Active Roster Users], [Instrumented Seats] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Seat ROI
		lineageTag: 5f25b658-d758-494e-bab7-cae193ccf083

	/// Percentage-point delta vs the prior equal-length window (#117: pp for ratio KPIs, % for count KPIs).
	/// BLANK unless both windows have data — a delta against an empty prior window is meaningless.
	/// #294: the prior ratio shifts the window around the whole quotient (the [Idle Seats PP] pattern) rather than
	/// dividing prior-window actives by current-window seats. Once [Paid Seats] is date-aware that mixed form is
	/// wrong by the seat growth itself — 13 seats in April against 184 in July.
	measure 'Seat Utilization Δ' =
			VAR Days = COUNTROWS ( dim_date )
			VAR FirstDay = MIN ( dim_date[date_day] )
			VAR Cur = [Seat Utilization %]
			VAR Prior =
			    CALCULATE (
			        [Seat Utilization %],
			        DATESBETWEEN ( dim_date[date_day], FirstDay - Days, FirstDay - 1 )
			    )
			RETURN
			    IF ( NOT ISBLANK ( Cur ) && NOT ISBLANK ( Prior ), ( Cur - Prior ) * 100 )
		formatString: +0.0 "pp";-0.0 "pp";0.0 "pp"
		displayFolder: Seat ROI
		lineageTag: 7d3fb1ad-3b35-4a81-ae17-112bd15b133a

	/// Instrumented seats with no activity in the selected window — the taxonomy's dormant seats (#290).
	/// #294: subtracted from [Instrumented Seats], not [Paid Seats]. Over the licensed population the remainder is
	/// 165, of which 164 are seats the installer never reached; calling those idle charges developers for an
	/// instrumentation gap. Scoped to instrumented seats the word is true again — a working install, unused in the
	/// window. The never-reached seats are #295's coverage story, not an idleness figure.
	/// Both guards cover a window with no seat-days (an absolute range in the Filters pane predating the roster
	/// history, or a PP window before it): BLANK - 19 is -19 in DAX, and a stray active whose seat has no seat-day
	/// in the window would otherwise render a negative bar and invert the sign of [Idle Seats Δ].
	measure 'Idle Seats' =
			IF (
			    NOT ISBLANK ( [Instrumented Seats] ),
			    MAX ( 0, [Instrumented Seats] - [Active Roster Users] )
			)
		formatString: #,##0
		displayFolder: Seat ROI
		lineageTag: bd969746-a64b-4bec-a015-c34ffbc8417c

	/// #173 (map #153, adopt-findings #158 Q1/Q2/Q15; ADR-0007). Flat per-seat plan list price,
	/// USD/seat/month, confirmed by Ahmed at PR #201 review (issue #173).
	measure 'Standard Seat Price' = 25
		formatString: \$#,##0
		displayFolder: Seat ROI\Cost
		lineageTag: a1730001-0000-4000-8000-000000000173

	measure 'Premium Seat Price' = 125
		formatString: \$#,##0
		displayFolder: Seat ROI\Cost
		lineageTag: a1730002-0000-4000-8000-000000000173

	/// API-equivalent value consumed = SUM of the promoted fact_api_usage[cost_usd] (#170, ADR-0007).
	/// Filter-context aware (selected relative-date window + slicers). ITWorx pays a flat per-seat plan,
	/// so this is value consumed at metered-API rates, never marginal spend.
	measure 'Value Consumed' = SUM ( fact_api_usage[cost_usd] )
		formatString: \$#,##0.00
		displayFolder: Seat ROI\Cost
		lineageTag: a1730003-0000-4000-8000-000000000173

	/// Monthly cost of the *instrumented* seats: Premium seats × Premium price + the rest at Standard price.
	/// A monthly rate, but no longer period-independent — [Instrumented Seats] is now counted over the daily seat
	/// fact, so the rate follows the window's seat population; [Value vs Seat Ratio] prorates it by Days/30.
	/// #294: renamed from 'Monthly Seat Cost' and rebased onto [Instrumented Seats]. It exists only as the ROI
	/// denominator (no visual binds it), and its numerator [Value Consumed] is observable on instrumented seats
	/// alone — costing all 184 against value from 20 would divide by the rollout gap and read as a 9x collapse in
	/// the tool's worth. Total licensed spend, if a card ever needs it, is this formula over [Paid Seats].
	/// The Premium split filters the dimension, matching the tier basis [Paid Seats] bridges on, so it follows IS's
	/// real tier mix instead of the two tiers the fabricated roster hardcoded. KEEPFILTERS so an outer tier
	/// selection intersects: without it, sl_tier = Standard would be overwritten and every seat priced at Premium.
	measure 'Instrumented Seat Cost' =
			VAR Premium = CALCULATE ( [Instrumented Seats], KEEPFILTERS ( dim_seat_current[seat_tier] = "Premium" ) )
			VAR Standard = [Instrumented Seats] - Premium
			RETURN Premium * [Premium Seat Price] + Standard * [Standard Seat Price]
		formatString: \$#,##0
		displayFolder: Seat ROI\Cost
		lineageTag: a1730004-0000-4000-8000-000000000173

	/// Value-vs-seat ROI (#173, research item 7): value consumed in the window over the seat cost for the
	/// SAME window. Monthly seat cost is prorated by Days/30 (nominal month) so the multiple stays
	/// period-consistent when the relative-date window changes (#165).
	/// #294: both sides are now scoped to instrumented seats — see [Instrumented Seat Cost].
	measure 'Value vs Seat Ratio' =
			VAR Days = COUNTROWS ( dim_date )
			VAR WindowSeatCost = [Instrumented Seat Cost] * DIVIDE ( Days, 30 )
			RETURN DIVIDE ( [Value Consumed], WindowSeatCost )
		formatString: 0.0"×"
		displayFolder: Seat ROI\Cost
		lineageTag: a1730005-0000-4000-8000-000000000173

	/// ROI-tile delta triplet (mirrors the Overview KPI pattern): hidden prior-window ratio / Δ (% change) /
	/// label. The prior window is equal-length, so the Days/30 proration cancels and the delta compares two
	/// like-for-like ratios.
	/// #294: seat cost is no longer date-independent — [Instrumented Seats] moves with the window — so the delta is
	/// a genuine ROI change (value per seat-dollar), not just the value-consumed change it reduced to before.
	measure 'Value vs Seat Ratio PP' =
			VAR Days = COUNTROWS ( dim_date )
			VAR FirstDay = MIN ( dim_date[date_day] )
			RETURN
			    CALCULATE ( [Value vs Seat Ratio], DATESBETWEEN ( dim_date[date_day], FirstDay - Days, FirstDay - 1 ) )
		formatString: 0.0"×"
		isHidden
		displayFolder: Seat ROI\Cost\Support
		lineageTag: a1730007-0000-4000-8000-000000000173

	measure 'Value vs Seat Ratio Δ' = DIVIDE ( [Value vs Seat Ratio] - [Value vs Seat Ratio PP], [Value vs Seat Ratio PP] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Seat ROI\Cost
		lineageTag: a1730008-0000-4000-8000-000000000173

	measure 'Value vs Seat Ratio Δ Label' =
			VAR D = [Value vs Seat Ratio Δ]
			VAR N = COUNTROWS ( dim_date )
			RETURN
			    IF ( ISBLANK ( D ), "— vs " & N & "d", FORMAT ( D, "+0.0%;-0.0%" ) & " vs " & N & "d" )
		displayFolder: Seat ROI\Cost
		lineageTag: a1730009-0000-4000-8000-000000000173

	/// Distinct actives per calendar ISO week (all telemetry, #117 decision 5); the incomplete
	/// current week returns BLANK so the trend never ends in a fake dip.
	measure 'Weekly Active Users' =
			VAR Anchor = CALCULATE ( MAX ( dim_date[date_day] ), ALL ( dim_date ) )
			VAR WeekEnd = MAX ( dim_date[week_start] ) + 6
			RETURN
			    IF ( WeekEnd <= Anchor, DISTINCTCOUNT ( fact_session_daily[user_email] ) )
		formatString: #,##0
		displayFolder: Seat ROI
		lineageTag: a233816c-5328-45ad-8f54-a9d9399761fe

	/// Distinct actives per calendar month (all telemetry, mirrors [Weekly Active Users], #177); the
	/// incomplete current month returns BLANK — guarded by month-end vs the latest data date, no fake dip.
	measure 'Monthly Active Users' =
			VAR Anchor = CALCULATE ( MAX ( dim_date[date_day] ), ALL ( dim_date ) )
			VAR MonthEnd = EOMONTH ( MAX ( dim_date[month_start] ), 0 )
			RETURN
			    IF ( MonthEnd <= Anchor, DISTINCTCOUNT ( fact_session_daily[user_email] ) )
		formatString: #,##0
		displayFolder: Seat ROI
		lineageTag: b7c4f1a8-2e93-45d6-8a01-6f3d9c2e7b15

	/// Month-over-month change in [Monthly Active Users] for the per-column trend label (#177). Prior month
	/// via REMOVEFILTERS + month_start (clears the month_label axis filter — a bare month_start filter would
	/// intersect empty against it); BLANK when either month is guarded so the first column carries no fake Δ.
	measure 'MAU MoM Δ' =
			VAR PriorMonth = EDATE ( MAX ( dim_date[month_start] ), -1 )
			VAR Cur = [Monthly Active Users]
			VAR Prior =
			    CALCULATE (
			        [Monthly Active Users],
			        REMOVEFILTERS ( dim_date ),
			        dim_date[month_start] = PriorMonth
			    )
			RETURN
			    IF ( NOT ISBLANK ( Cur ) && NOT ISBLANK ( Prior ) && Prior <> 0, DIVIDE ( Cur - Prior, Prior ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Seat ROI
		lineageTag: c9e2a7d4-5b81-42f0-9c36-8a1e4f7b2d63

	/// Cohorts (#117): growth-accounting semantics, leadership labels, roster-scoped, exhaustive
	/// with [Idle Seats]: New + Retained + Reactivated + Idle = Instrumented Seats. Window = selection (#165).
	/// #294: the identity is against [Instrumented Seats], not [Paid Seats] — the cohorts count instrumented people
	/// whose seat is on IS's roster, so the licensed seats the installer never reached are outside it by design.
	measure 'New Users' =
			VAR WindowStart = MIN ( dim_date[date_day] )
			VAR WindowEnd = MAX ( dim_date[date_day] )
			RETURN
			    COUNTROWS (
			        FILTER (
			            dim_user,
			            NOT ISBLANK ( RELATED ( dim_seat_current[user_email] ) )
			                && dim_user[first_seen] >= WindowStart
			                && dim_user[first_seen] <= WindowEnd
			        )
			    ) + 0
		formatString: #,##0
		displayFolder: Cohorts
		lineageTag: 21e7484a-8148-4f90-aed1-3e48a518cba9

	measure 'Retained Users' =
			VAR Days = COUNTROWS ( dim_date )
			VAR FirstDay = MIN ( dim_date[date_day] )
			VAR Roster =
			    CALCULATETABLE (
			        VALUES ( dim_user[user_email] ),
			        FILTER ( dim_user, NOT ISBLANK ( RELATED ( dim_seat_current[user_email] ) ) )
			    )
			VAR Cur = VALUES ( fact_session_daily[user_email] )
			VAR Prior =
			    CALCULATETABLE (
			        VALUES ( fact_session_daily[user_email] ),
			        DATESBETWEEN ( dim_date[date_day], FirstDay - Days, FirstDay - 1 )
			    )
			RETURN
			    COUNTROWS ( INTERSECT ( INTERSECT ( Cur, Prior ), Roster ) ) + 0
		formatString: #,##0
		displayFolder: Cohorts
		lineageTag: a8c1cffb-b47a-4ce8-9b3e-345296387e63

	/// Framework term "resurrected": active now, idle the prior window, first_seen older than the window.
	measure 'Reactivated Users' =
			VAR Days = COUNTROWS ( dim_date )
			VAR FirstDay = MIN ( dim_date[date_day] )
			VAR Roster =
			    CALCULATETABLE (
			        VALUES ( dim_user[user_email] ),
			        FILTER ( dim_user, NOT ISBLANK ( RELATED ( dim_seat_current[user_email] ) ) )
			    )
			VAR OldUsers =
			    CALCULATETABLE (
			        VALUES ( dim_user[user_email] ),
			        FILTER ( dim_user, dim_user[first_seen] < FirstDay )
			    )
			VAR Cur = VALUES ( fact_session_daily[user_email] )
			VAR Prior =
			    CALCULATETABLE (
			        VALUES ( fact_session_daily[user_email] ),
			        DATESBETWEEN ( dim_date[date_day], FirstDay - Days, FirstDay - 1 )
			    )
			RETURN
			    COUNTROWS ( INTERSECT ( INTERSECT ( EXCEPT ( Cur, Prior ), Roster ), OldUsers ) ) + 0
		formatString: #,##0
		displayFolder: Cohorts
		lineageTag: f1be67b7-e0b0-429e-bb70-d6026e48640b

	/// Overview KPI delta triplets (#117, #165): base measure (selected window) / hidden PP / Δ (% change
	/// for counts). Value cards bind the plain base measure; PP is the prior equal-length window.
	measure 'Commits PP' =
			VAR Days = COUNTROWS ( dim_date )
			VAR FirstDay = MIN ( dim_date[date_day] )
			RETURN
			    CALCULATE ( [Total Commits], DATESBETWEEN ( dim_date[date_day], FirstDay - Days, FirstDay - 1 ) )
		formatString: #,##0
		isHidden
		displayFolder: Overview KPIs\Support
		lineageTag: cc7641a9-e948-471d-bc5b-101e9390f73e

	measure 'Commits Δ' = DIVIDE ( [Total Commits] - [Commits PP], [Commits PP] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Overview KPIs
		lineageTag: bcb9dfe6-9f39-4788-9a62-73ef9773093d

	measure 'PRs PP' =
			VAR Days = COUNTROWS ( dim_date )
			VAR FirstDay = MIN ( dim_date[date_day] )
			RETURN
			    CALCULATE ( [Total PRs], DATESBETWEEN ( dim_date[date_day], FirstDay - Days, FirstDay - 1 ) )
		formatString: #,##0
		isHidden
		displayFolder: Overview KPIs\Support
		lineageTag: e4ef796f-e436-474c-9d57-7537f59ffbda

	measure 'PRs Δ' = DIVIDE ( [Total PRs] - [PRs PP], [PRs PP] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Overview KPIs
		lineageTag: 39ab83fd-bee3-4e7a-b30c-f46bffd29f62

	measure 'Lines of Code PP' =
			VAR Days = COUNTROWS ( dim_date )
			VAR FirstDay = MIN ( dim_date[date_day] )
			RETURN
			    CALCULATE ( [Total Lines of Code], DATESBETWEEN ( dim_date[date_day], FirstDay - Days, FirstDay - 1 ) )
		formatString: #,##0
		isHidden
		displayFolder: Overview KPIs\Support
		lineageTag: 55b53aee-ca99-42a6-91a2-42eb77a22be1

	measure 'Lines of Code Δ' = DIVIDE ( [Total Lines of Code] - [Lines of Code PP], [Lines of Code PP] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Overview KPIs
		lineageTag: f61d1735-ecdc-4ad6-85b5-372579854154

	measure 'Tool Acceptance Rate PP' =
			VAR Days = COUNTROWS ( dim_date )
			VAR FirstDay = MIN ( dim_date[date_day] )
			RETURN
			    CALCULATE ( [Tool Acceptance Rate], DATESBETWEEN ( dim_date[date_day], FirstDay - Days, FirstDay - 1 ) )
		formatString: 0.0%;-0.0%;0.0%
		isHidden
		displayFolder: Overview KPIs\Support
		lineageTag: e5e40f42-c930-42ea-9d45-72334b12cdda

	/// Ratio KPI, so the delta is percentage points (#117).
	/// BLANK unless both windows have data — a delta against an empty prior window is meaningless.
	measure 'Tool Acceptance Rate Δ' =
			VAR Cur = [Tool Acceptance Rate]
			VAR Prior = [Tool Acceptance Rate PP]
			RETURN
			    IF ( NOT ISBLANK ( Cur ) && NOT ISBLANK ( Prior ), ( Cur - Prior ) * 100 )
		formatString: +0.0 "pp";-0.0 "pp";0.0 "pp"
		displayFolder: Overview KPIs
		lineageTag: 16c383c8-71a0-47ed-9fad-43c923c3eabe

	/// input + output only — cache tokens excluded from volume and mix (#117 decision 8).
	measure 'Total Tokens' = [Total Input Tokens] + [Total Output Tokens]
		formatString: #,##0
		displayFolder: Usage & Capacity
		lineageTag: 51f7073b-03db-45ee-b074-84b07fe59ab5

	/// cache_read / all prompt-side tokens (#117 decision 7) — no precomputed rate exists in the marts.
	measure 'Cache Hit Ratio' =
			DIVIDE (
			    SUM ( fact_api_usage[cache_read_tokens] ),
			    SUM ( fact_api_usage[input_tokens] )
			        + SUM ( fact_api_usage[cache_read_tokens] )
			        + SUM ( fact_api_usage[cache_creation_tokens] )
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Usage & Capacity
		lineageTag: f8d88307-ec8d-404f-a322-2e30a4736193

	/// Ecosystem pattern (#117), one pair per bridge: distinct bridge sessions / [Total Sessions],
	/// and distinct users whose sessions used the capability.
	measure 'Sessions Using Agents %' = DIVIDE ( DISTINCTCOUNT ( bridge_session_agent[session_id] ), [Total Sessions] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Ecosystem
		lineageTag: 6892ec47-1a29-495e-9156-45e46be4cf8e

	measure 'Users Using Agents' =
			CALCULATE (
			    DISTINCTCOUNT ( fact_session[user_email] ),
			    KEEPFILTERS ( TREATAS ( VALUES ( bridge_session_agent[session_id] ), fact_session[session_id] ) )
			)
		formatString: #,##0 "users"
		displayFolder: Ecosystem
		lineageTag: 6655c7df-d933-4068-a2cd-417338416c76

	measure 'Sessions Using Skills %' = DIVIDE ( DISTINCTCOUNT ( bridge_session_skill[session_id] ), [Total Sessions] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Ecosystem
		lineageTag: 60ce71f5-fa8d-426d-a90a-5964b00d9dc2

	measure 'Users Using Skills' =
			CALCULATE (
			    DISTINCTCOUNT ( fact_session[user_email] ),
			    KEEPFILTERS ( TREATAS ( VALUES ( bridge_session_skill[session_id] ), fact_session[session_id] ) )
			)
		formatString: #,##0 "users"
		displayFolder: Ecosystem
		lineageTag: 52c5fda2-8fe1-48d0-9346-66d442c3b9fa

	measure 'Sessions Using MCP %' = DIVIDE ( DISTINCTCOUNT ( bridge_session_mcp[session_id] ), [Total Sessions] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Ecosystem
		lineageTag: 50e9feac-a17b-4627-aa2a-34f20e25608a

	measure 'Users Using MCP' =
			CALCULATE (
			    DISTINCTCOUNT ( fact_session[user_email] ),
			    KEEPFILTERS ( TREATAS ( VALUES ( bridge_session_mcp[session_id] ), fact_session[session_id] ) )
			)
		formatString: #,##0 "users"
		displayFolder: Ecosystem
		lineageTag: 6b545f99-6015-4de5-a187-0d2dac007698

	measure 'Sessions Using Hooks %' = DIVIDE ( DISTINCTCOUNT ( bridge_session_hook[session_id] ), [Total Sessions] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Ecosystem
		lineageTag: 60963357-d909-4212-a47b-d5f0b193c94e

	measure 'Users Using Hooks' =
			CALCULATE (
			    DISTINCTCOUNT ( fact_session[user_email] ),
			    KEEPFILTERS ( TREATAS ( VALUES ( bridge_session_hook[session_id] ), fact_session[session_id] ) )
			)
		formatString: #,##0 "users"
		displayFolder: Ecosystem
		lineageTag: 00255e33-7c8c-43ed-85bc-04bbb13e9835

	measure 'Sessions Using Plugins %' = DIVIDE ( DISTINCTCOUNT ( bridge_session_plugin[session_id] ), [Total Sessions] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Ecosystem
		lineageTag: c0813387-b0a0-4ab3-935a-a1a5d8cda398

	measure 'Users Using Plugins' =
			CALCULATE (
			    DISTINCTCOUNT ( fact_session[user_email] ),
			    KEEPFILTERS ( TREATAS ( VALUES ( bridge_session_plugin[session_id] ), fact_session[session_id] ) )
			)
		formatString: #,##0 "users"
		displayFolder: Ecosystem
		lineageTag: a2a7369f-0c07-4f9e-8dc0-b716f8e8484e

	/// Actives in the selected window with no roster row — the headline exclusion, surfaced (#117 decision 2).
	measure 'Off-Roster Active Users' =
			CALCULATE (
			    DISTINCTCOUNT ( fact_session_daily[user_email] ),
			    FILTER ( dim_user, ISBLANK ( RELATED ( dim_seat_current[user_email] ) ) )
			)
		formatString: #,##0
		displayFolder: Data Health
		lineageTag: ad8752e9-4c15-4182-a3c2-a571460975f0

	/// All-time: telemetry identities (incl. is_unknown) with no roster row.
	measure 'Roster Mismatch Count' = COUNTROWS ( FILTER ( ALL ( dim_user ), ISBLANK ( RELATED ( dim_seat_current[user_email] ) ) ) )
		formatString: #,##0
		displayFolder: Data Health
		lineageTag: 7f426481-4c81-4b6a-9e31-c45412e896fd

	measure 'DQ Findings' = COUNTROWS ( dq_finding )
		formatString: #,##0
		displayFolder: Data Health
		lineageTag: 62b922f3-1e40-4a6a-8f0e-cabed5dbf026

	/// Third tier for the DQ FINDINGS card (#330) — the only card in pg_health's six-card band
	/// that left the slot empty, so the band's bottom edge read ragged under that column.
	/// A delta is not available here: dq_finding carries detected_at but has no dim_date
	/// relationship, so [DQ Findings] is an all-time count and a "vs Nd" delta over it would
	/// render a permanent +0.0%. Mirrors [Last Mart Refresh]'s treatment on the band's first
	/// card instead — a freshness stamp, not a delta. The prefix rides in the formatString,
	/// same as that measure.
	measure 'Last DQ Finding' = MAX ( dq_finding[detected_at] )
		formatString: "Latest " dd MMM HH:mm
		displayFolder: Data Health
		lineageTag: b3300001-0000-4000-8000-000000000330

	/// Report-display helper: Executive Overview hero card sub-line.
	/// #294: says "instrumented", not "paid seats" — it explains a utilization headline now denominated on the seats
	/// telemetry reaches, so quoting the licensed count here would leave the ratio looking wrong.
	/// Kept to ~30 characters: crd_hero_detail is 232px with 4px of slack before crd_roi and is left-aligned with
	/// crd_hero_delta, so it cannot be widened — a longer string truncates to an ellipsis mid-sentence.
	/// Blank when the window holds no seat-days, rather than concatenating an empty count into "19 of  instrumented".
	measure 'Seat Utilization Detail' =
			IF (
			    NOT ISBLANK ( [Instrumented Seats] ),
			    [Active Roster Users] & " of " & [Instrumented Seats] & " instrumented · " & [Idle Seats] & " idle"
			)
		displayFolder: Seat ROI
		lineageTag: 437fa2bc-e7ee-4ba3-ab8b-4499e3ed9cfc

	/// Report-display helper: header data-freshness badge text.
	/// Self-explanatory display label (Fresh/Delayed/Stale) — the internal status keys (Fresh/Amber/Red)
	/// stay untouched so [Freshness Color] keeps mapping the pill colour. #197: when the imported dim_date
	/// snapshot trails the viewer clock by >= 2 days, the detail swaps "Xh ago" for "Nd behind" (calendar
	/// lag, isolated from telemetry quiet via [Snapshot Calendar Lag]) so the reader sees why the
	/// relative-date slicer window is short — a swap, not an append, because the header pill has no room
	/// for both (append truncates; #197 width verification).
	measure 'Data Freshness Badge' =
			VAR H = [Hours Since Last Signal]
			VAR SnapLag = [Snapshot Calendar Lag]
			VAR Label =
			    SWITCH (
			        [Data Freshness Status],
			        "Fresh", "Fresh",
			        "Amber", "Late",
			        "Red", "Stale",
			        [Data Freshness Status]
			    )
			VAR Detail = IF ( SnapLag >= 2, SnapLag & "d behind", FORMAT ( H, "#,##0" ) & "h ago" )
			RETURN
			    IF ( ISBLANK ( H ), "No data", Label & " · " & Detail )
		displayFolder: Ingest Health
		lineageTag: 5fee9ee6-e3d6-4277-8492-0091cbbbd88a

	/// Report-display helpers: KPI delta sub-lines (#119 polish, #165 dynamic window). Never blank — a
	/// first-window report shows "— vs Nd" instead of "(Blank)"; N tracks the selected window.
	/// The compact "vs Nd" suffix is report-wide (#318). It started as an Executive-only exception because
	/// that page packs a hero card plus five KPIs into 1224 units, so its delta cards are only 137
	/// wide and the long form truncates at the 12pt readable minimum (#309). It became the convention
	/// because on pg_eco the long form was the widest element on the card, out-inking the 24pt value it
	/// modifies and leaving tiers 3 and 4 separated by colour alone.
	measure 'Seat Utilization Δ Label' =
			VAR D = [Seat Utilization Δ]
			VAR N = COUNTROWS ( dim_date )
			RETURN
			    IF ( ISBLANK ( D ), "— vs " & N & "d", FORMAT ( D, "+0.0;-0.0" ) & " pp vs " & N & "d" )
		displayFolder: Seat ROI
		lineageTag: b1190001-0000-4000-8000-000000000119

	measure 'Commits Δ Label' =
			VAR D = [Commits Δ]
			VAR N = COUNTROWS ( dim_date )
			RETURN
