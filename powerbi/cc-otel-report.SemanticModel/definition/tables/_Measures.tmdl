	measure 'Off-Roster Active Users Δ Label' =
			VAR D = [Off-Roster Active Users Δ]
			VAR N = COUNTROWS ( dim_date )
			VAR Verdict = IF ( D > 0, " · worse", IF ( D < 0, " · better", "" ) )
			RETURN
			    IF ( ISBLANK ( D ), "— vs " & N & "d", FORMAT ( D, "+0.0%;-0.0%" ) & " vs " & N & "d" & Verdict )
		displayFolder: Data Health
		lineageTag: b1780064-0000-4000-8000-000000000178

	measure 'Off-Roster Active Users Δ Color' =
			VAR D = [Off-Roster Active Users Δ]
			RETURN
			    IF ( ISBLANK ( D ) || D = 0, "#5A6473", IF ( D > 0, "#B61E24", "#4F6F17" ) )
		displayFolder: Data Health
		lineageTag: b1780065-0000-4000-8000-000000000178

	measure 'Unknown Email Users PP' =
			VAR Days = COUNTROWS ( dim_date )
			VAR FirstDay = MIN ( dim_date[date_day] )
			RETURN
			    CALCULATE ( [Unknown Email Users], DATESBETWEEN ( dim_date[date_day], FirstDay - Days, FirstDay - 1 ) )
		isHidden
		displayFolder: Ingest Health\Support
		lineageTag: b1780066-0000-4000-8000-000000000178

	measure 'Unknown Email Users Δ' = DIVIDE ( [Unknown Email Users] - [Unknown Email Users PP], [Unknown Email Users PP] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Ingest Health
		lineageTag: b1780067-0000-4000-8000-000000000178

	measure 'Unknown Email Users Δ Label' =
			VAR D = [Unknown Email Users Δ]
			VAR N = COUNTROWS ( dim_date )
			VAR Verdict = IF ( D > 0, " · worse", IF ( D < 0, " · better", "" ) )
			RETURN
			    IF ( ISBLANK ( D ), "— vs " & N & "d", FORMAT ( D, "+0.0%;-0.0%" ) & " vs " & N & "d" & Verdict )
		displayFolder: Ingest Health
		lineageTag: b1780068-0000-4000-8000-000000000178

	measure 'Unknown Email Users Δ Color' =
			VAR D = [Unknown Email Users Δ]
			RETURN
			    IF ( ISBLANK ( D ) || D = 0, "#5A6473", IF ( D > 0, "#B61E24", "#4F6F17" ) )
		displayFolder: Ingest Health
		lineageTag: b1780069-0000-4000-8000-000000000178

	/// Mean per active day of time the user was actively prompting (active_time.user), in hours.
	measure 'Avg Active User Hours per Day' = DIVIDE(SUM(fact_session_daily[active_time_user_s]), [Active Days]) / 3600
		formatString: #,##0.0 "h"
		displayFolder: Adoption
		lineageTag: a1c00030-0000-4000-8000-000000000028

	/// Mean per active day of time the CLI was running (active_time.cli), in hours. Distinct from user-active time.
	measure 'Avg Active CLI Hours per Day' = DIVIDE(SUM(fact_session_daily[active_time_cli_s]), [Active Days]) / 3600
		formatString: #,##0.0 "h"
		displayFolder: Adoption
		lineageTag: a1c00031-0000-4000-8000-000000000028

	/// Total edit-decision events (accept/reject/...) from fact_edit_decision; powers the Impact decision-mix (#121).
	measure 'Edit Decisions' = SUM ( fact_edit_decision[decision_count] )
		formatString: #,##0
		displayFolder: Tool Quality
		lineageTag: 46f2bd60-c99d-4f35-a572-db29e80cb5e4

	/// Rejected-edit volume; replaces the two-bar decision-mix chart with a KPI on Impact (#152).
	measure 'Rejected Edits' = CALCULATE ( [Edit Decisions], fact_edit_decision[decision] = "reject" )
		formatString: #,##0
		displayFolder: Tool Quality
		lineageTag: 8d4f2a61-5b3c-47e9-a1d2-90c8e7b5f426

	/// Ecosystem depth-bar values (#123): raw usage intensity per bridge entity, summed over the session-x-name grain.
	measure 'Skill Activations' = SUM ( bridge_session_skill[activations] )
		formatString: #,##0
		displayFolder: Ecosystem
		lineageTag: e1c2a3b4-0001-4a11-9c01-aa0000000001

	measure 'MCP Calls' = SUM ( bridge_session_mcp[tool_calls] )
		formatString: #,##0
		displayFolder: Ecosystem
		lineageTag: e1c2a3b4-0002-4a11-9c01-aa0000000002

	measure 'Subagent Invocations' = SUM ( bridge_session_agent[invocations] )
		formatString: #,##0
		displayFolder: Ecosystem
		lineageTag: e1c2a3b4-0003-4a11-9c01-aa0000000003

	measure 'Hook Executions' = SUM ( bridge_session_hook[executions] )
		formatString: #,##0
		displayFolder: Ecosystem
		lineageTag: e1c2a3b4-0004-4a11-9c01-aa0000000004

	measure 'Plugin Loads' = SUM ( bridge_session_plugin[load_count] )
		formatString: #,##0
		displayFolder: Ecosystem
		lineageTag: e1c2a3b4-0005-4a11-9c01-aa0000000005

	/// User-detail drillthrough header (#125): the drilled user's identity, shown as cards.
	measure 'Selected User' = SELECTEDVALUE ( dim_user[user_email], "All users" )
		displayFolder: User Detail
		lineageTag: d1250001-0000-4000-8000-000000000125

	/// RELATED walks dim_user (many) -> dim_seat_current (one); blank means the identity holds no open seat.
	/// #294: the fallback carries the taxonomy's state name so the User Detail card and the Data Health
	/// reconciliation column say the same word for the same state.
	/// HASONEVALUE because MAXX over many users returns the alphabetical max, which is "Standard" — a plausible
	/// wrong tier rather than a visible fallback if the drillthrough filter ever fails to land.
	measure 'Selected User Tier' =
			IF (
			    HASONEVALUE ( dim_user[user_email] ),
			    COALESCE ( MAXX ( dim_user, RELATED ( dim_seat_current[seat_tier] ) ), "Off-roster identity" ),
			    "All users"
			)
		displayFolder: User Detail
		lineageTag: d1250002-0000-4000-8000-000000000125

	measure 'User First Seen' = FORMAT ( MIN ( dim_user[first_seen] ), "d MMM yyyy" )
		displayFolder: User Detail
		lineageTag: d1250003-0000-4000-8000-000000000125

	measure 'User Last Seen' = FORMAT ( MAX ( dim_user[last_seen] ), "d MMM yyyy" )
		displayFolder: User Detail
		lineageTag: d1250004-0000-4000-8000-000000000125

	/// Session-detail measures (#125). fact_api_usage / fact_edit_decision / fact_session_daily relate to
	/// fact_session[session_id] via INACTIVE relationships; USERELATIONSHIP routes the drillthrough filter
	/// (which lands on fact_session) into each fact. Without it these would ignore the drilled session.
	measure 'Session User' = SELECTEDVALUE ( fact_session[user_email], "—" )
		displayFolder: Session Detail
		lineageTag: d1250005-0000-4000-8000-000000000125

	measure 'Session Started' = FORMAT ( MIN ( fact_session[started_at] ), "d MMM yyyy HH:mm" )
		displayFolder: Session Detail
		lineageTag: d1250006-0000-4000-8000-000000000125

	measure 'Session Start Type' = SELECTEDVALUE ( fact_session[start_type], "—" )
		displayFolder: Session Detail
		lineageTag: d1250007-0000-4000-8000-000000000125

	measure 'Session CC Version' = SELECTEDVALUE ( fact_session[cc_version], "—" )
		displayFolder: Session Detail
		lineageTag: d1250008-0000-4000-8000-000000000125

	measure 'Session Duration' =
			VAR S = SUM ( fact_session[duration_s] )
			RETURN
			    IF ( ISBLANK ( S ), BLANK (), INT ( S / 3600 ) & "h " & INT ( MOD ( S, 3600 ) / 60 ) & "m" )
		displayFolder: Session Detail
		lineageTag: d1250009-0000-4000-8000-000000000125

	measure 'Session Tokens' = CALCULATE ( [Total Tokens], USERELATIONSHIP ( fact_api_usage[session_id], fact_session[session_id] ) )
		formatString: #,##0
		displayFolder: Session Detail
		lineageTag: d125000a-0000-4000-8000-000000000125

	measure 'Session Requests' = CALCULATE ( [Total Requests], USERELATIONSHIP ( fact_api_usage[session_id], fact_session[session_id] ) )
		formatString: #,##0
		displayFolder: Session Detail
		lineageTag: d125000b-0000-4000-8000-000000000125

	measure 'Session Cache Hit Ratio' = CALCULATE ( [Cache Hit Ratio], USERELATIONSHIP ( fact_api_usage[session_id], fact_session[session_id] ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Session Detail
		lineageTag: d125000c-0000-4000-8000-000000000125

	measure 'Session Prompts' = CALCULATE ( [Total Prompts], USERELATIONSHIP ( fact_session_daily[session_id], fact_session[session_id] ) )
		formatString: #,##0
		displayFolder: Session Detail
		lineageTag: d125000d-0000-4000-8000-000000000125

	measure 'Session Tool Acceptance Rate' = CALCULATE ( [Tool Acceptance Rate], USERELATIONSHIP ( fact_edit_decision[session_id], fact_session[session_id] ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Session Detail
		lineageTag: d125000e-0000-4000-8000-000000000125

	measure 'Session Edit Decisions' = CALCULATE ( [Edit Decisions], USERELATIONSHIP ( fact_edit_decision[session_id], fact_session[session_id] ) )
		formatString: #,##0
		displayFolder: Session Detail
		lineageTag: d125000f-0000-4000-8000-000000000125

	/// Per-session API-equivalent value consumed for the user-detail sessions table (#173). fact_api_usage
	/// relates to fact_session via an INACTIVE relationship; USERELATIONSHIP routes the drillthrough filter
	/// into the fact (mirrors [Session Tokens]).
	measure 'Session Value' = CALCULATE ( [Value Consumed], USERELATIONSHIP ( fact_api_usage[session_id], fact_session[session_id] ) )
		formatString: \$#,##0.00
		displayFolder: Session Detail
		lineageTag: a1730006-0000-4000-8000-000000000173

	/// Axis measure for the 'Ecosystem Bridge' disconnected table (#125): one bar per bridge.
	measure 'Ecosystem Intensity' =
			SWITCH (
			    SELECTEDVALUE ( 'Ecosystem Bridge'[Bridge] ),
			    "Skills", [Skill Activations],
			    "MCP", [MCP Calls],
			    "Subagents", [Subagent Invocations],
			    "Hooks", [Hook Executions],
			    "Plugins", [Plugin Loads]
			)
		formatString: #,##0
		displayFolder: Ecosystem
		lineageTag: d1250010-0000-4000-8000-000000000125

	/// Weekly-trend guards (#165): blank the incomplete current ISO week so the by-week lines never end
	/// in a fake dip (copies the [Weekly Active Users] pattern). Bound only by the by-week trend charts.
	measure 'Commits (Weekly)' =
			VAR Anchor = CALCULATE ( MAX ( dim_date[date_day] ), ALL ( dim_date ) )
			VAR WeekEnd = MAX ( dim_date[week_start] ) + 6
			RETURN
			    IF ( WeekEnd <= Anchor, [Total Commits] )
		formatString: #,##0
		displayFolder: Trends
		lineageTag: a1650001-0000-4000-8000-000000000165

	measure 'PRs (Weekly)' =
			VAR Anchor = CALCULATE ( MAX ( dim_date[date_day] ), ALL ( dim_date ) )
			VAR WeekEnd = MAX ( dim_date[week_start] ) + 6
			RETURN
			    IF ( WeekEnd <= Anchor, [Total PRs] )
		formatString: #,##0
		displayFolder: Trends
		lineageTag: a1650002-0000-4000-8000-000000000165

	measure 'Lines of Code (Weekly)' =
			VAR Anchor = CALCULATE ( MAX ( dim_date[date_day] ), ALL ( dim_date ) )
			VAR WeekEnd = MAX ( dim_date[week_start] ) + 6
			RETURN
			    IF ( WeekEnd <= Anchor, [Total Lines of Code] )
		formatString: #,##0
		displayFolder: Trends
		lineageTag: a1650003-0000-4000-8000-000000000165

	measure 'Input Tokens (Weekly)' =
			VAR Anchor = CALCULATE ( MAX ( dim_date[date_day] ), ALL ( dim_date ) )
			VAR WeekEnd = MAX ( dim_date[week_start] ) + 6
			RETURN
			    IF ( WeekEnd <= Anchor, [Total Input Tokens] )
		formatString: #,##0
		displayFolder: Trends
		lineageTag: a1650004-0000-4000-8000-000000000165

	measure 'Output Tokens (Weekly)' =
			VAR Anchor = CALCULATE ( MAX ( dim_date[date_day] ), ALL ( dim_date ) )
			VAR WeekEnd = MAX ( dim_date[week_start] ) + 6
			RETURN
			    IF ( WeekEnd <= Anchor, [Total Output Tokens] )
		formatString: #,##0
		displayFolder: Trends
		lineageTag: a1650005-0000-4000-8000-000000000165

	column Value
		dataType: int64
		isHidden
		lineageTag: 8f1efc75-7bf7-4108-80f2-d122b6a69db6
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

	partition _Measures = calculated
		mode: import
		source = {1}

