table fact_session

	column session_id
		dataType: string
		summarizeBy: none
		sourceColumn: session_id

		annotation SummarizationSetBy = Automatic

	column start_type
		dataType: string
		summarizeBy: none
		sourceColumn: start_type

		annotation SummarizationSetBy = Automatic

	column user_email
		dataType: string
		summarizeBy: none
		sourceColumn: user_email

		annotation SummarizationSetBy = Automatic

	column started_at
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: started_at

		annotation SummarizationSetBy = Automatic

	column cc_version
		dataType: string
		summarizeBy: none
		sourceColumn: cc_version

		annotation SummarizationSetBy = Automatic

	column duration_s
		dataType: int64
		formatString: 0
		summarizeBy: sum
		sourceColumn: duration_s

		annotation SummarizationSetBy = Automatic

	column activity_date
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: activity_date

		annotation SummarizationSetBy = Automatic

	partition fact_session = m
		mode: import
		source =
				let
				  Source = Value.NativeQuery(PostgreSQL.Database("ccotel-pg-interim.postgres.database.azure.com", "cc_otel"), "SELECT t.*, t.started_at::date AS activity_date FROM marts.fact_session t")
				in
				  Source

	annotation PBI_ResultType = Table

