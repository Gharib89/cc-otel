table bridge_session_mcp

	column session_id
		dataType: string
		summarizeBy: none
		sourceColumn: session_id

		annotation SummarizationSetBy = Automatic

	column mcp_name
		dataType: string
		summarizeBy: none
		sourceColumn: mcp_name

		annotation SummarizationSetBy = Automatic

	column tool_calls
		dataType: int64
		formatString: 0
		summarizeBy: sum
		sourceColumn: tool_calls

		annotation SummarizationSetBy = Automatic

	partition bridge_session_mcp = m
		mode: import
		source =
				let
				  Source = Value.NativeQuery(PostgreSQL.Database("ccotel-pg-interim.postgres.database.azure.com", "cc_otel"), "SELECT * FROM marts.bridge_session_mcp")
				in
				  Source

	annotation PBI_ResultType = Table

