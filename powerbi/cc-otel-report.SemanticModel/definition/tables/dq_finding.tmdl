table dq_finding

	column id
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: id

		annotation SummarizationSetBy = Automatic

	column finding_type
		dataType: string
		summarizeBy: none
		sourceColumn: finding_type

		annotation SummarizationSetBy = Automatic

	column detected_at
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: detected_at

		annotation SummarizationSetBy = Automatic

	column row_count
		dataType: int64
		formatString: 0
		summarizeBy: sum
		sourceColumn: row_count

		annotation SummarizationSetBy = Automatic

	column details
		dataType: string
		summarizeBy: none
		sourceColumn: details

		annotation SummarizationSetBy = Automatic

	partition dq_finding = m
		mode: import
		source =
				let
				  Source = PostgreSQL.Database("ccotel-pg-interim.postgres.database.azure.com", "cc_otel"),
				  #"Navigation 1" = Source{[Schema = "marts", Item = "dq_finding"]}[Data]
				in
				  #"Navigation 1"

	annotation PBI_ResultType = Table

