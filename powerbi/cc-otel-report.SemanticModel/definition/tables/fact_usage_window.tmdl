table fact_usage_window

	column user_email
		dataType: string
		summarizeBy: none
		sourceColumn: user_email

		annotation SummarizationSetBy = Automatic

	column window_type
		dataType: string
		summarizeBy: none
		sourceColumn: window_type

		annotation SummarizationSetBy = Automatic

	column window_end
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: window_end

		annotation SummarizationSetBy = Automatic

	column segment_no
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: segment_no

		annotation SummarizationSetBy = Automatic

	column end_pct
		dataType: double
		summarizeBy: none
		sourceColumn: end_pct

		annotation SummarizationSetBy = Automatic

	column peak_pct
		dataType: double
		summarizeBy: none
		sourceColumn: peak_pct

		annotation SummarizationSetBy = Automatic

	column peak_ts
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: peak_ts

		annotation SummarizationSetBy = Automatic

	column first_sample_ts
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: first_sample_ts

		annotation SummarizationSetBy = Automatic

	column last_sample_ts
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: last_sample_ts

		annotation SummarizationSetBy = Automatic

	column sample_count
		dataType: int64
		formatString: 0
		summarizeBy: sum
		sourceColumn: sample_count

		annotation SummarizationSetBy = Automatic

	column window_start
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: window_start

		annotation SummarizationSetBy = Automatic

	column is_reset_split
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_reset_split

		annotation SummarizationSetBy = Automatic

	column pace_pct_per_hour
		dataType: double
		summarizeBy: none
		sourceColumn: pace_pct_per_hour

		annotation SummarizationSetBy = Automatic

	column activity_date
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: activity_date

		annotation SummarizationSetBy = Automatic

	partition fact_usage_window = m
		mode: import
		source =
				let
				  Source = Value.NativeQuery(PostgreSQL.Database("ccotel-pg-interim.postgres.database.azure.com", "cc_otel"), "SELECT t.*, t.window_end::date AS activity_date FROM marts.fact_usage_window t")
				in
				  Source

	annotation PBI_ResultType = Table

