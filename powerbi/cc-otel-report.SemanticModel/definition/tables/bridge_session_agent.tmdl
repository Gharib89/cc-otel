table bridge_session_agent

	column session_id
		dataType: string
		summarizeBy: none
		sourceColumn: session_id

		annotation SummarizationSetBy = Automatic

	column agent_name
		dataType: string
		summarizeBy: none
		sourceColumn: agent_name

		annotation SummarizationSetBy = Automatic

	column invocations
		dataType: int64
		formatString: 0
		summarizeBy: sum
		sourceColumn: invocations

		annotation SummarizationSetBy = Automatic

	partition bridge_session_agent = m
		mode: import
		source =
				let
				  Source = Value.NativeQuery(PostgreSQL.Database("ccotel-pg-interim.postgres.database.azure.com", "cc_otel"), "SELECT * FROM marts.bridge_session_agent")
				in
				  Source

	annotation PBI_ResultType = Table

