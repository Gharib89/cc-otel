# Postgres connection for ad-hoc psql + the sink writer. Migration authoring
# uses scripts/dev-migrate.sh (throwaway Docker Postgres), not this URL.
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/cc_otel?sslmode=require"

# --- Sink service (sink/) ---
# Bind address: localhost only — the collector fronts the sink in the same
# Container App; the sink must never get its own external ingress (#6).
CC_OTEL_SINK_HOST="127.0.0.1"
CC_OTEL_SINK_PORT="8080"
# Blob raw reservoir (ADR-0005). Unset ⇒ reservoir disabled. In production use
# CC_OTEL_BLOB_ACCOUNT_URL with the ACA managed identity; a connection string is
# for local/dev only.
CC_OTEL_BLOB_ACCOUNT_URL=""
CC_OTEL_BLOB_CONNECTION_STRING=""
CC_OTEL_BLOB_CONTAINER="raw"
# Compacted reservoir (ADR-0015) — the derived parquet read cache `tools.compact`
# writes and the analysis notebooks prefer. Operator-side only; the sink never
# touches it. Unset ⇒ reads go straight to the raw container, as before.
CC_OTEL_BLOB_COMPACTED_CONTAINER="compacted"
